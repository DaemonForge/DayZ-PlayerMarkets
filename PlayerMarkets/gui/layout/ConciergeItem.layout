FrameWidgetClass ItemRoot {
 clipchildren 0
 ignorepointer 0
 color 1 1 1 0
 size 1 150
 halign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 1
 {
  ImageWidgetClass BG {
   ignorepointer 1
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   image0 "PlayerMarkets/gui/images/MarketItemBG.edds"
   mode blend
   "src alpha" 1
   "no wrap" 1
   stretch 1
  }
  FrameWidgetClass ItemPreviewFrame {
   ignorepointer 1
   position 8 0
   size 140 120
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    ItemPreviewWidgetClass ItemPreview {
     ignorepointer 1
     position 0 0
     size 0 0
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
    }
   }
  }
  FrameWidgetClass InfoFrame {
   ignorepointer 1
   position 156 10
   size 340 135
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    TextWidgetClass ItemName {
     clipchildren 0
     ignorepointer 1
     color 0 0 0 1
     position 0 0
     size 1 26
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "Item Name"
     font "PlayerMarkets/gui/fonts/Pangolin"
     "text color" 0 0 0 1
     "text valign" center
    }
    TextWidgetClass StallName {
     clipchildren 0
     ignorepointer 1
     color 0.55 0.45 0.3 1
     position 0 28
     size 1 20
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "@ Stall Name"
     font "gui/fonts/etelkatextpro"
     "text color" 0.55 0.45 0.3 1
     "text valign" center
    }
    GridSpacerWidgetClass ItemDetails {
     clipchildren 0
     ignorepointer 1
     position 0 0
     size 1 40
     valign bottom_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     Padding 6
     Margin 0
     "Size To Content H" 1
     Columns 80
     Rows 1
     {
      PanelWidgetClass ItemStateFrame {
       ignorepointer 1
       position 0 0
       size 24 1
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 1
       vexactsize 0
       {
        ImageWidgetClass ItemState {
         visible 1
         ignorepointer 1
         color 0 0 0 0
         size 14 14
         halign center_ref
         valign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         image0 "PlayerMarkets/gui/images/dot.edds"
         mode blend
         "src alpha" 1
         "no wrap" 0
         stretch 1
        }
       }
      }
      TextWidgetClass HealthText {
       ignorepointer 1
       color 0.3 0.3 0.3 1
       position 0 0
       size 80 35
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text ""
       font "gui/fonts/etelkatextpro"
       "text color" 0.3 0.3 0.3 1
       "size to text h" 1
       "text valign" center
      }
      TextWidgetClass Quanity {
       visible 0
       ignorepointer 1
       color 0.3 0.3 0.3 1
       position 0 0
       size 80 1
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 0
       text ""
       font "gui/fonts/etelkatextpro"
       "text color" 0.3 0.3 0.3 1
       "size to text h" 1
       "text valign" center
      }
      TextWidgetClass CategoryLabel {
       ignorepointer 1
       color 0.4 0.4 0.4 1
       position 0 0
       size 80 35
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "Weapon"
       font "gui/fonts/etelkatextpro"
       "text color" 0.4 0.4 0.4 1
       "size to text h" 1
       "text valign" center
      }
     }
    }
   }
  }
  FrameWidgetClass PriceFrame {
   ignorepointer 1
   position -10 0
   size 130 150
   halign right_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    TextWidgetClass Cost {
     ignorepointer 1
     color 0 0 0 1
     position 0 0
     size 1 30
     halign center_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "$5000"
     font "PlayerMarkets/gui/fonts/AmaticSCBold"
     "text halign" center
     "text valign" center
    }
    TextWidgetClass CurrencyLabel {
     ignorepointer 1
     color 0.4 0.4 0.4 1
     position 0 30
     size 1 18
     halign center_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "Coins"
     font "gui/fonts/etelkatextpro"
     "text color" 0.4 0.4 0.4 1
     "text halign" center
     "text valign" center
    }
   }
  }
 }
}
