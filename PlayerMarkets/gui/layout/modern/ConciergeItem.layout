FrameWidgetClass ItemRoot {
 clipchildren 0
 ignorepointer 0
 color 1 1 1 0
 size 1 140
 halign center_ref
 hexactpos 1
 vexactpos 1
 hexactsize 0
 vexactsize 1
 {
  PanelWidgetClass BG {
   ignorepointer 1
   color 0 0 0 0.9412
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style rover_sim_colorable
  }
  FrameWidgetClass ItemPreviewFrame {
   ignorepointer 1
   position 8 0
   size 128 120
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    ItemPreviewWidgetClass ItemPreview {
     ignorepointer 1
     position 0 0
     size 0 0
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
    }
   }
  }
  FrameWidgetClass InfoFrame {
   ignorepointer 1
   position 144 10
   size 340 126
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    TextWidgetClass ItemName {
     clipchildren 0
     ignorepointer 1
     position 0 0
     size 1 24
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "Item Name"
     font "PlayerMarkets/gui/fonts/modern/regular20"
     "text valign" center
    }
    TextWidgetClass StallName {
     clipchildren 0
     ignorepointer 1
     color 0.55 0.45 0.3 1
     position 0 26
     size 1 18
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "@ Stall Name"
     font "PlayerMarkets/gui/fonts/modern/regular16"
     "text color" 0.55 0.45 0.3 1
     "text valign" center
    }
    GridSpacerWidgetClass ItemDetails {
     clipchildren 0
     ignorepointer 1
     position 0 0
     size 1 36
     valign bottom_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     Padding 6
     Margin 0
     "Size To Content H" 1
     content_valign center
     Columns 80
     Rows 1
     {
      PanelWidgetClass ItemStateFrame {
       ignorepointer 1
       position 0 0
       size 24 1
       valign center_ref
       hexactpos 0
       vexactpos 0
       hexactsize 1
       vexactsize 0
       {
        PanelWidgetClass ItemState {
         visible 1
         ignorepointer 1
         color 0.2706 0.6235 0.3608 1
         size 14 14
         halign center_ref
         valign center_ref
         hexactpos 1
         vexactpos 1
         hexactsize 1
         vexactsize 1
         style rover_sim_colorable
        }
       }
      }
      TextWidgetClass HealthText {
       ignorepointer 1
       color 0.5 0.5 0.5 1
       position 0 0
       size 80 30
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text ""
       font "PlayerMarkets/gui/fonts/modern/regular16"
       "text color" 0.5 0.5 0.5 1
       "size to text h" 1
       "text valign" center
      }
      TextWidgetClass Quanity {
       visible 0
       ignorepointer 1
       color 0.5 0.5 0.5 1
       position 0 0
       size 80 1
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 0
       text ""
       font "PlayerMarkets/gui/fonts/modern/regular16"
       "text color" 0.5 0.5 0.5 1
       "size to text h" 1
       "text valign" center
      }
      TextWidgetClass CategoryLabel {
       ignorepointer 1
       color 0.4 0.4 0.4 1
       position 0 0
       size 80 30
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "Weapon"
       font "PlayerMarkets/gui/fonts/modern/regular16"
       "text color" 0.4 0.4 0.4 1
       "size to text h" 1
       "text valign" center
      }
     }
    }
   }
  }
  FrameWidgetClass PriceFrame {
   ignorepointer 1
   position -10 0
   size 120 140
   halign right_ref
   valign center_ref
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    TextWidgetClass Cost {
     ignorepointer 1
     position 0 0
     size 1 26
     halign center_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "$5000"
     font "PlayerMarkets/gui/fonts/modern/regular20"
     "text halign" center
     "text valign" center
    }
    TextWidgetClass CurrencyLabel {
     ignorepointer 1
     color 0.4 0.4 0.4 1
     position 0 26
     size 1 16
     halign center_ref
     hexactpos 0
     vexactpos 1
     hexactsize 0
     vexactsize 1
     text "Coins"
     font "PlayerMarkets/gui/fonts/modern/regular16"
     "text color" 0.4 0.4 0.4 1
     "text halign" center
     "text valign" center
    }
   }
  }
 }
}
