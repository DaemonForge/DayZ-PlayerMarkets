ButtonWidgetClass FilterButtonRoot {
 ignorepointer 0
 color 0.2 0.2 0.2 0.8
 size 100 32
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  TextWidgetClass FilterText {
   ignorepointer 1
   size 0.9 0.9
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   text "All"
   font "PlayerMarkets/gui/fonts/modern/regular16"
   "text color" 1 1 1 1
   "text halign" center
   "text valign" center
  }
  PanelWidgetClass FilterOutline {
   ignorepointer 1
   color 0.9961 1 1 1
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style Outline_1px
  }
 }
}
